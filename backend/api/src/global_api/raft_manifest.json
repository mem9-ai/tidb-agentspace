{
  "schema": "raft-agent-manifest.v0",
  "service": "agentspace",
  "name": "AgentSpace",
  "description": "Discover authorized resources, read files and execute permitted SQL with durable request deduplication.",
  "docs_url": "https://github.com/mem9-ai/tidb-agentspace/blob/main/docs/raft-agents.md",
  "app_origin": "https://agentspace.example",
  "execution": {
    "mode": "http_api",
    "base_url": "https://agentspace.example"
  },
  "auth": {
    "type": "login_with_raft",
    "login_url": "https://agentspace.example/auth/raft/login"
  },
  "actions": [
    {
      "name": "context",
      "description": "Verify your current identity and discover your own admission state.",
      "endpoint": {
        "method": "GET",
        "path": "/api/raft/actions/context"
      },
      "parameters": {},
      "returns": {
        "actor": {
          "type": "object"
        },
        "workspaces": {
          "type": "array"
        },
        "enrollmentRequired": {
          "type": "boolean"
        }
      }
    },
    {
      "name": "list-resources",
      "description": "List only resources you may discover, optionally filtered by organizational tags.",
      "endpoint": {
        "method": "GET",
        "path": "/api/raft/actions/list-resources"
      },
      "parameters": {
        "workspaceId": {
          "type": "string",
          "required": true
        },
        "cursor": {
          "type": "string"
        },
        "tags": {
          "type": "object",
          "description": "Optional bounded string key/value filters, exact match with AND semantics; filters never grant access."
        }
      },
      "returns": {
        "resources": {
          "type": "array"
        },
        "nextCursor": {
          "type": "string"
        }
      }
    },
    {
      "name": "read-file",
      "description": "Read an authorized file within service limits.",
      "endpoint": {
        "method": "GET",
        "path": "/api/raft/actions/read-file"
      },
      "parameters": {
        "workspaceId": {
          "type": "string",
          "required": true
        },
        "resourceId": {
          "type": "string",
          "required": true
        },
        "path": {
          "type": "string",
          "required": true
        }
      },
      "returns": {
        "content": {
          "type": "string"
        },
        "encoding": {
          "type": "string"
        }
      }
    },
    {
      "name": "query",
      "description": "Execute authorized SQL once per requestId. May modify data. After transport failure inspect query-status with the original requestId; never submit a new ID to retry an unknown write.",
      "endpoint": {
        "method": "POST",
        "path": "/api/raft/actions/query"
      },
      "parameters": {
        "workspaceId": {
          "type": "string",
          "required": true
        },
        "resourceId": {
          "type": "string",
          "required": true
        },
        "sql": {
          "type": "string",
          "required": true
        },
        "requestId": {
          "type": "string",
          "required": true,
          "description": "Caller-generated request UUID retained before sending. Reuse only for the same operation; inspect query-status after an unknown outcome."
        }
      },
      "returns": {
        "status": {
          "type": "string"
        },
        "operationId": {
          "type": "string"
        },
        "result": {
          "type": "object"
        }
      }
    },
    {
      "name": "query-status",
      "description": "Inspect your existing SQL request without executing it again. Requires current resource permission. Unknown outcome is not success or safe-to-retry.",
      "endpoint": {
        "method": "GET",
        "path": "/api/raft/actions/query-status"
      },
      "parameters": {
        "workspaceId": {
          "type": "string",
          "required": true
        },
        "resourceId": {
          "type": "string",
          "required": true
        },
        "requestId": {
          "type": "string",
          "required": true
        }
      },
      "returns": {
        "status": {
          "type": "string"
        },
        "result": {
          "type": "object"
        }
      }
    }
  ],
  "context_check": {
    "url": "https://agentspace.example/api/raft/actions/context",
    "method": "GET"
  }
}
