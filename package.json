{
  "name": "tidb-agent-workspace",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node server/dev.mjs",
    "build": "npm run build:console && npm run build:api",
    "preview": "npm run start:console",
    "test": "node --test",
    "start": "node server/index.mjs",
    "typecheck": "tsc -b",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "api:generate": "node server/generate-openapi.mjs && node tools/api-contract/generate-client.mjs",
    "api:check": "node server/generate-openapi.mjs --check && node tools/api-contract/generate-client.mjs --check",
    "check:runtime": "node scripts/check-runtime.mjs",
    "check:repo": "node scripts/check-repo.mjs",
    "check:signoff": "node scripts/check-signoff.mjs",
    "check": "npm run check:runtime && npm run check:repo && npm run format:check && npm run lint && npm run api:check && npm test && npm run build",
    "preinstall": "node scripts/check-runtime.mjs",
    "dev:console": "vite",
    "dev:api": "node --watch server/index.mjs",
    "build:console": "npm run typecheck && vite build",
    "build:api": "node scripts/build-api.mjs",
    "start:console": "node scripts/serve-console.mjs",
    "start:api": "node server/index.mjs",
    "package": "node scripts/package-runtime.mjs",
    "meta:build": "cargo build --locked --manifest-path meta-service/Cargo.toml",
    "meta:check": "npm run meta:build && cargo fmt --manifest-path meta-service/Cargo.toml --check && cargo clippy --manifest-path meta-service/Cargo.toml --locked --all-targets -- -D warnings && cargo test --manifest-path meta-service/Cargo.toml --locked && WORKSPACE_META_TEST=1 node --test server/meta-service.test.mjs",
    "meta:migrate": "node server/meta/migrate.mjs",
    "meta:local": "node server/meta/local-runtime.mjs",
    "meta:export": "node server/meta/export-legacy.mjs",
    "meta:api": "node server/meta/start-api.mjs",
    "meta:gateway": "node server/meta/gateway-ownership.mjs",
    "backend:build": "cargo build --workspace --locked",
    "backend:check": "npm run backend:build && cargo fmt --all --check && cargo clippy --workspace --all-targets --locked -- -D warnings && cargo test --workspace --locked && WORKSPACE_META_TEST=1 WORKSPACE_BACKEND_TEST=1 node --test server/meta-service.test.mjs server/rust-backend.test.mjs"
  },
  "dependencies": {
    "@codemirror/lang-sql": "6.10.0",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.15",
    "@duckdb/node-api": "2.0.0-r.1",
    "@fontsource-variable/inter": "5.3.0",
    "@tidbcloud/codemirror-extension-themes": "0.0.6",
    "@tidbcloud/tisqleditor-react": "0.0.6",
    "@tidbcloud/uikit": "2.9.1",
    "just-bash": "3.6.0",
    "mysql2": "3.24.6",
    "openapi-fetch": "0.17.0",
    "pg": "8.23.1",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-hook-form": "7.91.0",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.19.2",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "@vitejs/plugin-react": "6.1.2",
    "ajv": "8.20.0",
    "eslint": "10.13.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.5",
    "yaml": "2.9.1"
  },
  "engines": {
    "node": ">=24.22.1 <25",
    "npm": "11.6.2"
  },
  "packageManager": "npm@11.6.2",
  "workspaces": [
    "tools/api-contract"
  ],
  "overrides": {
    "guarded-fetch": {
      "undici": "7.30.1"
    }
  }
}
