{
  "name": "tidb-agent-workspace",
  "version": "0.1.0",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run build:console",
    "preview": "npm run start:console",
    "test": "node --test",
    "start": "cargo run --locked -p workspace-backend -- serve-api",
    "typecheck": "tsc -b",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "api:generate": "cargo run --locked -p workspace-openapi -- export && node tools/api-contract/generate-client.mjs",
    "api:check": "cargo run --locked -p workspace-openapi -- check && node tools/api-contract/generate-client.mjs --check",
    "check:runtime": "node scripts/check-runtime.mjs",
    "check:repo": "node scripts/check-repo.mjs",
    "check": "npm run check:runtime && npm run check:repo && npm run format:check && npm run lint && npm run api:check && npm test && npm run build",
    "agent-sdk:generate": "node scripts/generate-agent-sdk.mjs",
    "agent-sdk:check": "node scripts/generate-agent-sdk.mjs --check",
    "preinstall": "node scripts/check-runtime.mjs",
    "dev:console": "vite",
    "dev:api": "cargo run --locked -p workspace-backend -- serve-api",
    "build:console": "npm run agent-sdk:check && npm run typecheck && vite build",
    "build:api": "npm run backend:build",
    "start:console": "node scripts/serve-console.mjs",
    "start:api": "cargo run --locked -p workspace-backend -- serve-api",
    "package": "node scripts/package-runtime.mjs",
    "meta:build": "cargo build --locked --manifest-path meta-service/Cargo.toml",
    "meta:check": "cargo fmt --all --check && cargo clippy --locked -p workspace-meta-service --all-targets -- -D warnings && cargo test --locked -p workspace-meta-service && cargo build --locked -p workspace-meta-service -p workspace-domain --bins --examples && cargo test --locked -p workspace-test-support --test meta -- --ignored --test-threads=1",
    "meta:local": "cargo run --locked -p workspace-backend -- local",
    "backend:build": "cargo run --locked -p workspace-build-tools -- prepare && cargo build --locked --workspace --bins --examples",
    "backend:fmt": "cargo fmt --all --check",
    "backend:clippy": "cargo clippy --workspace --all-targets --locked -- -D warnings",
    "backend:test": "cargo test --workspace --locked",
    "backend:test:integration": "cargo acceptance all",
    "backend:test:classic": "cargo acceptance classic",
    "backend:check": "npm run backend:fmt && npm run backend:build && npm run backend:clippy && npm run backend:test && npm run backend:test:integration",
    "build:api:rust": "npm run backend:build",
    "package:api:rust": "cargo run --locked -p workspace-build-tools -- package",
    "backend:prepare": "cargo run --locked -p workspace-build-tools -- prepare",
    "start:api:rust": "cargo run --locked -p workspace-backend -- serve-api",
    "test:browser": "playwright test",
    "test:browser:ui": "playwright test --ui",
    "test:browser:trace": "playwright show-trace",
    "test:agent-clients": "node tools/agent-client-tests/live.mjs"
  },
  "dependencies": {
    "@codemirror/lang-sql": "6.10.0",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.15",
    "@fontsource-variable/inter": "5.3.0",
    "@tidbcloud/codemirror-extension-themes": "0.0.6",
    "@tidbcloud/tisqleditor-react": "0.0.6",
    "@tidbcloud/uikit": "2.9.1",
    "mermaid": "12.2.0",
    "openapi-fetch": "0.17.0",
    "parse5": "8.1.1",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-hook-form": "7.91.0",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@types/node": "24.19.2",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "@vitejs/plugin-react": "6.1.2",
    "eslint": "10.13.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.5",
    "yaml": "2.9.1"
  },
  "engines": {
    "node": ">=24.22.1 <25",
    "npm": "11.6.2"
  },
  "packageManager": "npm@11.6.2",
  "workspaces": [
    "tools/agent-client-tests",
    "tools/api-contract"
  ]
}
