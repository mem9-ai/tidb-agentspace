{
  "openapi": "3.1.0",
  "info": {
    "title": "Workspace Global Public API",
    "version": "0.1.0",
    "description": "Independent Global management authority. Key and Global Token issuance are available. Regional data and refresh endpoints are served by Region directly. All expiry values use Unix seconds. Credentials must never be logged or stored in URLs."
  },
  "servers": [{ "url": "/api" }],
  "paths": {
    "/v1/token-issuances": {
      "post": {
        "operationId": "createDiscoveredTokenIssuance",
        "summary": "Exchange a Workspace Key without configuring a Workspace or Region",
        "security": [{ "workspaceKey": [] }],
        "description": "The Key identifies its Workspace. Use audience global or region; region selects the Key-granted Region. Legacy Keys without a Workspace hint continue to use the Workspace-scoped issuance endpoint. Never forward the Workspace Key to a Region.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "audience": { "enum": ["global", "region"] },
                  "scopes": { "type": "array", "items": { "type": "string" } },
                  "clientThumbprint": { "type": "string" }
                },
                "required": ["audience"]
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Successful response",
            "headers": { "Cache-Control": { "schema": { "const": "no-store" } } },
            "content": {
              "application/json": {
                "schema": {
                  "oneOf": [
                    { "$ref": "#/components/schemas/DiscoveredToken" },
                    { "$ref": "#/components/schemas/DiscoveredRegionAccessToken" },
                    { "$ref": "#/components/schemas/DiscoveredRegionToken" }
                  ]
                }
              }
            }
          },
          "default": {
            "description": "Successful response",
            "headers": { "Cache-Control": { "schema": { "const": "no-store" } } },
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/Error" } }
            }
          }
        }
      }
    },
    "/v1/workspaces/{workspaceId}/region-route": {
      "get": {
        "operationId": "getGlobalRegionRoute",
        "summary": "Discover the Region through a bodyless redirect",
        "security": [{ "globalAccess": [] }],
        "parameters": [
          {
            "name": "workspaceId",
            "in": "path",
            "required": true,
            "schema": { "type": "string", "pattern": "^[A-Za-z0-9_.:-]{1,128}$" }
          }
        ],
        "description": "Send only a Global access Token. Inspect the redirect without automatic credential forwarding; validate the HTTPS target against authenticated Global discovery before using the Region Token. Do not send SQL or file content to this endpoint.",
        "responses": {
          "307": {
            "description": "Region API base URL. No data request has been sent to Global.",
            "headers": {
              "Location": { "required": true, "schema": { "type": "string", "format": "uri" } },
              "X-Region-Id": { "required": true, "schema": { "type": "string" } },
              "Cache-Control": { "schema": { "const": "no-store" } }
            }
          },
          "default": {
            "description": "Successful response",
            "headers": { "Cache-Control": { "schema": { "const": "no-store" } } },
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/Error" } }
            }
          }
        }
      }
    },
    "/v1/workspaces/{workspaceId}/regions": {
      "get": {
        "operationId": "listAuthorizedRegions",
        "summary": "List Authorized Regions",
        "security": [{ "globalAccess": [] }],
        "parameters": [
          {
            "name": "workspaceId",
            "in": "path",
            "required": true,
            "schema": { "type": "string", "pattern": "^[A-Za-z0-9_.:-]{1,128}$" }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response",
            "headers": { "Cache-Control": { "schema": { "const": "no-store" } } },
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "data": { "type": "array", "items": { "$ref": "#/components/schemas/Region" } },
                    "nextCursor": { "type": "null" }
                  },
                  "required": ["data", "nextCursor"]
                }
              }
            }
          },
          "default": {
            "description": "Structured denial or unknown outcome; no credential is echoed.",
            "headers": { "Cache-Control": { "schema": { "const": "no-store" } } },
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/Error" } }
            }
          }
        },
        "description": "Requires resources:read on a current Global Token. Only the Key-granted Region is returned. Data requests go directly to Region."
      }
    },
    "/v1/workspaces/{workspaceId}/issuances/{issuanceId}": {
      "get": {
        "operationId": "getGlobalTokenIssuance",
        "summary": "Get Global Token Issuance",
        "security": [{ "globalAccess": [] }],
        "parameters": [
          {
            "name": "workspaceId",
            "in": "path",
            "required": true,
            "schema": { "type": "string", "pattern": "^[A-Za-z0-9_.:-]{1,128}$" }
          },
          { "name": "issuanceId", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "responses": {
          "200": {
            "description": "Successful response",
            "headers": { "Cache-Control": { "schema": { "const": "no-store" } } },
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": { "data": { "$ref": "#/components/schemas/Issuance" } },
                  "required": ["data"]
                }
              }
            }
          },
          "default": {
            "description": "Structured denial or unknown outcome; no credential is echoed.",
            "headers": { "Cache-Control": { "schema": { "const": "no-store" } } },
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/Error" } }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Error": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "error": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "code": { "type": "string" },
              "message": { "type": "string" },
              "requestId": { "type": "string" }
            },
            "required": ["code", "message", "requestId"]
          }
        },
        "required": ["error"]
      },
      "Key": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "name": { "type": "string", "minLength": 1, "maxLength": 80 },
          "createdAt": { "type": "integer", "minimum": 0 },
          "workspaceId": { "type": "string" },
          "keyId": { "type": "string", "format": "uuid" },
          "principalId": { "type": "string" },
          "keyVersion": { "type": "integer", "minimum": 1 },
          "grantRef": { "type": "string" },
          "expiresAt": { "type": "integer", "minimum": 1 },
          "revoked": { "type": "boolean" }
        },
        "required": [
          "name",
          "createdAt",
          "workspaceId",
          "keyId",
          "principalId",
          "keyVersion",
          "grantRef",
          "expiresAt",
          "revoked"
        ]
      },
      "Grants": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "scopes": {
            "type": "array",
            "items": { "type": "string" },
            "minItems": 1,
            "maxItems": 8
          },
          "resourceIds": {
            "type": "array",
            "items": { "type": "string" },
            "minItems": 1,
            "maxItems": 1024
          },
          "regionId": { "type": "string" }
        },
        "required": ["scopes", "resourceIds", "regionId"]
      },
      "Region": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "regionId": { "type": "string" },
          "apiOrigin": { "type": "string", "format": "uri" },
          "apiPathPrefix": { "type": "string" }
        },
        "required": ["regionId", "apiOrigin", "apiPathPrefix"]
      },
      "Issuance": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string" },
          "keyId": { "type": "string" },
          "principalId": { "type": "string" },
          "expiresAt": { "type": "integer", "minimum": 1 },
          "audience": { "type": "string" },
          "status": { "const": "issued" }
        },
        "required": ["id", "keyId", "principalId", "expiresAt", "audience", "status"]
      },
      "Token": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string" },
          "accessToken": { "type": "string" },
          "tokenType": { "const": "Bearer" },
          "expiresAt": { "type": "integer", "minimum": 1 },
          "scopes": { "type": "array", "items": { "type": "string" } }
        },
        "required": ["id", "accessToken", "tokenType", "expiresAt", "scopes"]
      },
      "RegionToken": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string" },
          "accessToken": { "type": "string" },
          "tokenType": { "const": "Bearer" },
          "expiresAt": { "type": "integer", "minimum": 1 },
          "scopes": { "type": "array", "items": { "type": "string" } },
          "keyId": { "type": "string" },
          "principalId": { "type": "string" },
          "keyVersion": { "type": "integer", "minimum": 1 },
          "region": { "$ref": "#/components/schemas/Region" },
          "enrollmentTicket": { "type": "string" },
          "enrollmentExpiresAt": { "type": "integer", "minimum": 1 },
          "nonce": { "type": "string" }
        },
        "required": [
          "id",
          "accessToken",
          "tokenType",
          "expiresAt",
          "scopes",
          "keyId",
          "principalId",
          "keyVersion",
          "region",
          "enrollmentTicket",
          "enrollmentExpiresAt",
          "nonce"
        ]
      },
      "RegionAccessToken": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string" },
          "accessToken": { "type": "string" },
          "tokenType": { "const": "Bearer" },
          "expiresAt": { "type": "integer", "minimum": 1 },
          "scopes": { "type": "array", "items": { "type": "string" } },
          "keyId": { "type": "string" },
          "principalId": { "type": "string" },
          "keyVersion": { "type": "integer", "minimum": 1 },
          "region": { "$ref": "#/components/schemas/Region" }
        },
        "required": [
          "id",
          "accessToken",
          "tokenType",
          "expiresAt",
          "scopes",
          "keyId",
          "principalId",
          "keyVersion",
          "region"
        ]
      },
      "DiscoveredToken": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string" },
          "accessToken": { "type": "string" },
          "tokenType": { "const": "Bearer" },
          "expiresAt": { "type": "integer", "minimum": 1 },
          "scopes": { "type": "array", "items": { "type": "string" } },
          "workspaceId": { "type": "string" }
        },
        "required": ["id", "accessToken", "tokenType", "expiresAt", "scopes", "workspaceId"]
      },
      "DiscoveredRegionAccessToken": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string" },
          "accessToken": { "type": "string" },
          "tokenType": { "const": "Bearer" },
          "expiresAt": { "type": "integer", "minimum": 1 },
          "scopes": { "type": "array", "items": { "type": "string" } },
          "keyId": { "type": "string" },
          "principalId": { "type": "string" },
          "keyVersion": { "type": "integer", "minimum": 1 },
          "region": { "$ref": "#/components/schemas/Region" },
          "workspaceId": { "type": "string" }
        },
        "required": [
          "id",
          "accessToken",
          "tokenType",
          "expiresAt",
          "scopes",
          "keyId",
          "principalId",
          "keyVersion",
          "region",
          "workspaceId"
        ]
      },
      "DiscoveredRegionToken": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string" },
          "accessToken": { "type": "string" },
          "tokenType": { "const": "Bearer" },
          "expiresAt": { "type": "integer", "minimum": 1 },
          "scopes": { "type": "array", "items": { "type": "string" } },
          "keyId": { "type": "string" },
          "principalId": { "type": "string" },
          "keyVersion": { "type": "integer", "minimum": 1 },
          "region": { "$ref": "#/components/schemas/Region" },
          "enrollmentTicket": { "type": "string" },
          "enrollmentExpiresAt": { "type": "integer", "minimum": 1 },
          "nonce": { "type": "string" },
          "workspaceId": { "type": "string" }
        },
        "required": [
          "id",
          "accessToken",
          "tokenType",
          "expiresAt",
          "scopes",
          "keyId",
          "principalId",
          "keyVersion",
          "region",
          "enrollmentTicket",
          "enrollmentExpiresAt",
          "nonce",
          "workspaceId"
        ]
      }
    },
    "securitySchemes": {
      "globalAccess": { "type": "http", "scheme": "bearer", "bearerFormat": "Global JWT" },
      "workspaceKey": {
        "type": "http",
        "scheme": "bearer",
        "description": "Workspace Key is sent only to Global token issuance, never forwarded to Region."
      }
    }
  }
}
