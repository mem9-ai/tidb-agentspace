            "minimum": 1,
            "type": "integer"
          },
          "nonce": {
            "type": "string"
          },
          "principalId": {
            "type": "string"
          },
          "region": {
            "$ref": "#/components/schemas/Region"
          },
          "scopes": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
