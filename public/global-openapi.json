{
  "openapi": "3.1.0",
  "info": {
    "title": "Workspace Global Public API",
    "version": "0.1.0",
    "description": "Independent Global management authority. Key and Global Token issuance are available. Regional data and refresh endpoints are served by Region directly. All expiry values use Unix seconds. Credentials must never be logged or stored in URLs."
  },
  "servers": [{ "url": "/" }],
  "paths": {
    "/api/v1/workspaces/{workspaceId}/key-policy-deliveries": {
      "post": {
        "operationId": "createGlobalKeyPolicyDelivery",
        "summary": "Create Global Key Policy Delivery",
        "security": [{ "globalOwner": [] }],
        "parameters": [
          {
            "name": "workspaceId",
            "in": "path",
            "required": true,
            "schema": { "type": "string", "pattern": "^[A-Za-z0-9_.:-]{1,128}$" }
          },
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": true,
            "schema": { "type": "string", "format": "uuid" },
            "description": "Operation identity. A repeated secret-producing operation never returns another secret. Resolve uncertain outcomes; do not blindly repeat."
          },
          {
            "name": "Origin",
            "in": "header",
            "required": true,
            "schema": { "type": "string", "format": "uri" },
            "description": "Must equal the Global public origin or an explicitly trusted Console origin for Owner mutations."
          }
        ],
        "responses": {
          "201": {
            "description": "Successful response",
            "headers": { "Cache-Control": { "schema": { "const": "no-store" } } },
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "data": {
                      "type": "object",
                      "additionalProperties": false,
                      "properties": {
                        "id": { "type": "string" },
                        "keyId": { "type": "string" },
                        "keyVersion": { "type": "integer", "minimum": 1 },
                        "regionalStatus": { "enum": ["pending", "applied"] },
                        "regionalContinuity": { "enum": ["pending", "eligible", "unavailable"] }
                      },
                      "required": [
                        "id",
                        "keyId",
                        "keyVersion",
                        "regionalStatus",
                        "regionalContinuity"
                      ]
                    }
                  },
                  "required": ["data"]
                }
              }
            }
          },
          "default": {
            "description": "Structured denial or unknown outcome; no credential is echoed.",
            "headers": { "Cache-Control": { "schema": { "const": "no-store" } } },
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/Error" } }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "keyId": { "type": "string" },
                  "keyVersion": { "type": "integer", "minimum": 1 }
                },
                "required": ["keyId", "keyVersion"]
              }
            }
          }
        },
        "description": "Explicit bounded application attempt for the current Key version, including revoked Keys. Replays reconcile the same immutable command. No background retry or data proxy is implied."
      }
    },
    "/api/v1/workspaces/{workspaceId}/key-policy-deliveries/{deliveryId}": {
      "get": {
        "operationId": "getGlobalKeyPolicyDelivery",
        "summary": "Get Global Key Policy Delivery",
        "security": [{ "globalOwner": [] }],
        "parameters": [
          {
            "name": "workspaceId",
            "in": "path",
            "required": true,
            "schema": { "type": "string", "pattern": "^[A-Za-z0-9_.:-]{1,128}$" }
          },
          { "name": "deliveryId", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "responses": {
          "200": {
            "description": "Successful response",
            "headers": { "Cache-Control": { "schema": { "const": "no-store" } } },
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "data": {
                      "type": "object",
                      "additionalProperties": false,
                      "properties": {
                        "id": { "type": "string" },
                        "keyId": { "type": "string" },
                        "keyVersion": { "type": "integer", "minimum": 1 },
                        "regionalStatus": { "enum": ["pending", "applied"] },
                        "regionalContinuity": { "enum": ["pending", "eligible", "unavailable"] }
                      },
                      "required": [
                        "id",
                        "keyId",
                        "keyVersion",
                        "regionalStatus",
                        "regionalContinuity"
                      ]
                    }
                  },
                  "required": ["data"]
                }
              }
            }
          },
          "default": {
            "description": "Structured denial or unknown outcome; no credential is echoed.",
            "headers": { "Cache-Control": { "schema": { "const": "no-store" } } },
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/Error" } }
            }
          }
        },
        "description": "Observe durable application evidence without contacting Region or retrying effects."
      }
    },
    "/api/v1/workspaces/{workspaceId}/keys": {
      "get": {
        "operationId": "listGlobalKeys",
        "summary": "List Global Keys",
        "security": [{ "globalOwner": [] }],
        "parameters": [
          {
            "name": "workspaceId",
            "in": "path",
            "required": true,
            "schema": { "type": "string", "pattern": "^[A-Za-z0-9_.:-]{1,128}$" }
          },
          { "name": "cursor", "in": "query", "schema": { "type": "string" } },
          {
            "name": "limit",
            "in": "query",
            "schema": { "type": "integer", "minimum": 1, "maximum": 100, "default": 50 }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response",
            "headers": { "Cache-Control": { "schema": { "const": "no-store" } } },
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "data": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "additionalProperties": false,
                        "properties": {
                          "data": { "$ref": "#/components/schemas/Key" },
                          "grants": { "$ref": "#/components/schemas/Grants" },
                          "regionalStatus": { "enum": ["pending", "applied"] }
                        },
                        "required": ["data", "grants", "regionalStatus"]
                      }
                    },
                    "nextCursor": { "type": ["string", "null"] }
                  },
                  "required": ["data", "nextCursor"]
                }
              }
            }
          },
          "default": {
            "description": "Structured denial or unknown outcome; no credential is echoed.",
            "headers": { "Cache-Control": { "schema": { "const": "no-store" } } },
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/Error" } }
            }
          }
        }
      },
      "post": {
        "operationId": "createGlobalKey",
        "summary": "Create Global Key",
        "security": [{ "globalOwner": [] }],
        "parameters": [
          {
            "name": "workspaceId",
            "in": "path",
            "required": true,
            "schema": { "type": "string", "pattern": "^[A-Za-z0-9_.:-]{1,128}$" }
          },
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": true,
            "schema": { "type": "string", "format": "uuid" },
            "description": "Operation identity. A repeated secret-producing operation never returns another secret. Resolve uncertain outcomes; do not blindly repeat."
          },
          {
            "name": "Origin",
            "in": "header",
            "required": true,
            "schema": { "type": "string", "format": "uri" },
            "description": "Must equal the Global public origin or an explicitly trusted Console origin for Owner mutations."
          }
        ],
        "responses": {
          "201": {
            "description": "Successful response",
            "headers": { "Cache-Control": { "schema": { "const": "no-store" } } },
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "data": { "$ref": "#/components/schemas/Key" },
                    "secret": { "type": "string" },
                    "grants": { "$ref": "#/components/schemas/Grants" },
                    "regionalStatus": { "enum": ["pending", "applied"] }
                  },
                  "required": ["data", "secret", "grants", "regionalStatus"]
                }
              }
            }
          },
          "default": {
            "description": "Structured denial or unknown outcome; no credential is echoed.",
            "headers": { "Cache-Control": { "schema": { "const": "no-store" } } },
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/Error" } }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "name": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 80,
                    "default": "Agent key"
                  },
                  "scopes": {
                    "type": "array",
                    "items": { "type": "string" },
                    "minItems": 1,
                    "maxItems": 8
                  },
                  "resourceIds": {
                    "type": "array",
                    "items": { "type": "string" },
                    "minItems": 1,
                    "maxItems": 1024
                  },
                  "expiresAt": { "type": "integer", "minimum": 1 }
                },
                "required": ["scopes", "resourceIds", "expiresAt"]
              }
            }
          }
        },
        "description": "Owner only. Unix-second expiry. Store the returned secret securely; it cannot be retrieved or returned again."
      }
    },
    "/api/v1/workspaces/{workspaceId}/keys/{keyId}": {
      "get": {
        "operationId": "getGlobalKey",
        "summary": "Get Global Key",
        "security": [{ "globalOwner": [] }],
        "parameters": [
          {
            "name": "workspaceId",
            "in": "path",
            "required": true,
            "schema": { "type": "string", "pattern": "^[A-Za-z0-9_.:-]{1,128}$" }
          },
          { "name": "keyId", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "responses": {
          "200": {
            "description": "Successful response",
            "headers": { "Cache-Control": { "schema": { "const": "no-store" } } },
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "data": { "$ref": "#/components/schemas/Key" },
                    "grants": { "$ref": "#/components/schemas/Grants" },
                    "regionalStatus": { "enum": ["pending", "applied"] }
                  },
                  "required": ["data", "grants", "regionalStatus"]
                }
              }
            }
          },
          "default": {
            "description": "Structured denial or unknown outcome; no credential is echoed.",
            "headers": { "Cache-Control": { "schema": { "const": "no-store" } } },
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/Error" } }
            }
          }
        }
      },
      "patch": {
        "operationId": "renewGlobalKey",
        "summary": "Renew Global Key",
        "security": [{ "globalOwner": [] }],
        "parameters": [
          {
            "name": "workspaceId",
            "in": "path",
            "required": true,
            "schema": { "type": "string", "pattern": "^[A-Za-z0-9_.:-]{1,128}$" }
          },
          { "name": "keyId", "in": "path", "required": true, "schema": { "type": "string" } },
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": true,
            "schema": { "type": "string", "format": "uuid" },
            "description": "Operation identity. A repeated secret-producing operation never returns another secret. Resolve uncertain outcomes; do not blindly repeat."
          },
          {
            "name": "If-Match",
            "in": "header",
            "required": true,
            "schema": { "type": "string" },
            "description": "Quoted current Key version ETag."
          },
          {
            "name": "Origin",
            "in": "header",
            "required": true,
            "schema": { "type": "string", "format": "uri" },
            "description": "Must equal the Global public origin or an explicitly trusted Console origin for Owner mutations."
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response",
            "headers": { "Cache-Control": { "schema": { "const": "no-store" } } },
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "data": { "$ref": "#/components/schemas/Key" },
                    "regionalStatus": { "enum": ["pending", "applied"] },
                    "regionalContinuity": { "enum": ["pending", "eligible", "unavailable"] }
                  },
                  "required": ["data", "regionalStatus", "regionalContinuity"]
                }
              }
            }
          },
          "default": {
            "description": "Structured denial or unknown outcome; no credential is echoed.",
            "headers": { "Cache-Control": { "schema": { "const": "no-store" } } },
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/Error" } }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "properties": { "expiresAt": { "type": "integer", "minimum": 1 } },
                "required": ["expiresAt"]
              }
            }
          }
        },
        "description": "Extends expiry while retaining the Key secret, advances Key version and invalidates old Global Tokens. Regional application is reported separately. Only an explicit same-secret renewal durably observed by both authorities before the previous expiry enables existing proof-bound families to cross versions. An unreachable Region remains pending; unavailable continuity requires fresh enrollment."
      },
      "delete": {
        "operationId": "revokeGlobalKey",
        "summary": "Revoke Global Key",
        "security": [{ "globalOwner": [] }],
        "parameters": [
          {
            "name": "workspaceId",
            "in": "path",
            "required": true,
            "schema": { "type": "string", "pattern": "^[A-Za-z0-9_.:-]{1,128}$" }
          },
          { "name": "keyId", "in": "path", "required": true, "schema": { "type": "string" } },
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": true,
            "schema": { "type": "string", "format": "uuid" },
            "description": "Operation identity. A repeated secret-producing operation never returns another secret. Resolve uncertain outcomes; do not blindly repeat."
          },
          {
            "name": "If-Match",
            "in": "header",
            "required": true,
            "schema": { "type": "string" },
            "description": "Quoted current Key version ETag."
          },
          {
            "name": "Origin",
            "in": "header",
            "required": true,
            "schema": { "type": "string", "format": "uri" },
            "description": "Must equal the Global public origin or an explicitly trusted Console origin for Owner mutations."
          }
        ],
        "responses": {
          "202": {
            "description": "Successful response",
            "headers": { "Cache-Control": { "schema": { "const": "no-store" } } },
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "id": { "type": "string" },
                    "regionalStatus": { "enum": ["pending", "applied"] }
                  },
                  "required": ["id", "regionalStatus"]
                }
              }
            }
          },
          "default": {
            "description": "Structured denial or unknown outcome; no credential is echoed.",
            "headers": { "Cache-Control": { "schema": { "const": "no-store" } } },
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/Error" } }
            }
          }
        }
      }
    },
