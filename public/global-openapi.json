    },
    "/api/v1/workspaces/{workspaceId}/regions": {
      "get": {
        "operationId": "listAuthorizedRegions",
        "summary": "List Authorized Regions",
        "security": [{ "globalAccess": [] }],
        "parameters": [
          {
            "name": "workspaceId",
            "in": "path",
            "required": true,
            "schema": { "type": "string", "pattern": "^[A-Za-z0-9_.:-]{1,128}$" }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response",
            "headers": { "Cache-Control": { "schema": { "const": "no-store" } } },
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "data": { "type": "array", "items": { "$ref": "#/components/schemas/Region" } },
                    "nextCursor": { "type": "null" }
                  },
                  "required": ["data", "nextCursor"]
                }
              }
            }
          },
          "default": {
            "description": "Structured denial or unknown outcome; no credential is echoed.",
            "headers": { "Cache-Control": { "schema": { "const": "no-store" } } },
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/Error" } }
            }
          }
        },
        "description": "Requires resources:read on a current Global Token. Only the Key-granted Region is returned. Data requests go directly to Region."
      }
    },
    "/api/health": {
      "get": {
        "operationId": "getGlobalHealth",
        "security": [],
        "responses": {
          "200": {
            "description": "Successful response",
            "headers": { "Cache-Control": { "schema": { "const": "no-store" } } },
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": { "status": { "const": "ok" }, "authority": { "const": "global" } },
                  "required": ["status", "authority"]
                }
              }
            }
          },
          "default": {
            "description": "Successful response",
            "headers": { "Cache-Control": { "schema": { "const": "no-store" } } },
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/Error" } }
            }
          }
        }
      }
    },
    "/api/auth/config": {
      "get": {
        "operationId": "getGlobalAuthConfig",
        "security": [],
        "responses": {
          "200": {
            "description": "Successful response",
            "headers": { "Cache-Control": { "schema": { "const": "no-store" } } },
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "mode": { "enum": ["local", "oidc"] },
                    "loginPath": { "type": "string" },
                    "localSessionPath": { "type": "string" }
                  },
                  "required": ["mode", "loginPath", "localSessionPath"]
                }
              }
            }
          },
          "default": {
            "description": "Successful response",
            "headers": { "Cache-Control": { "schema": { "const": "no-store" } } },
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/Error" } }
            }
          }
        }
      }
    },
    "/api/auth/session": {
      "get": {
        "operationId": "getGlobalOwnerSession",
        "security": [{ "globalOwner": [] }],
        "parameters": [
          { "name": "workspaceId", "in": "query", "required": true, "schema": { "type": "string" } }
        ],
        "responses": {
          "200": {
            "description": "Successful response",
            "headers": { "Cache-Control": { "schema": { "const": "no-store" } } },
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "workspaceId": { "type": "string" },
                    "regionId": { "type": "string" }
                  },
                  "required": ["workspaceId", "regionId"]
                }
              }
            }
          },
          "default": {
            "description": "Successful response",
            "headers": { "Cache-Control": { "schema": { "const": "no-store" } } },
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/Error" } }
            }
          }
        }
      }
    },
    "/api/session": {
      "post": {
        "operationId": "createLocalGlobalOwnerSession",
        "security": [],
        "description": "Explicit development profile only, real loopback peer and trusted Origin required. Unavailable in hosted deployments.",
        "parameters": [
          {
            "name": "Origin",
            "in": "header",
            "required": true,
            "schema": { "type": "string", "format": "uri" },
            "description": "Must equal the Global public origin or an explicitly trusted Console origin for Owner mutations."
          }
        ],
        "responses": {
          "201": {
            "description": "Successful response",
            "headers": { "Cache-Control": { "schema": { "const": "no-store" } } },
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "workspaceId": { "type": "string" },
                    "regionId": { "type": "string" }
                  },
                  "required": ["workspaceId", "regionId"]
                }
              }
            }
          },
          "default": {
            "description": "Successful response",
            "headers": { "Cache-Control": { "schema": { "const": "no-store" } } },
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/Error" } }
            }
          }
        }
      }
    },
    "/api/auth/tidbcloud/login": {
      "get": {
        "operationId": "startGlobalOwnerLogin",
        "security": [],
        "parameters": [
          {
            "name": "workspaceId",
            "in": "query",
            "required": true,
            "schema": { "type": "string" }
          },
          {
            "name": "returnTo",
            "in": "query",
            "schema": { "type": "string", "format": "uri" },
            "description": "Optional return URL on an explicitly trusted Console origin."
          }
        ],
        "responses": {
          "303": {
            "description": "Redirect to the trusted configured identity provider; opaque host-only flow cookie."
          },
          "default": {
            "description": "Successful response",
            "headers": { "Cache-Control": { "schema": { "const": "no-store" } } },
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/Error" } }
            }
          }
        }
      }
    },
    "/api/auth/tidbcloud/callback": {
      "get": {
        "operationId": "completeGlobalOwnerLogin",
        "security": [],
        "parameters": [
          { "name": "code", "in": "query", "required": true, "schema": { "type": "string" } },
          { "name": "state", "in": "query", "required": true, "schema": { "type": "string" } }
        ],
        "responses": {
          "200": {
            "description": "Successful response",
            "headers": { "Cache-Control": { "schema": { "const": "no-store" } } },
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "workspaceId": { "type": "string" },
                    "regionId": { "type": "string" },
                    "expiresAt": { "type": "integer", "minimum": 1 }
                  },
                  "required": ["workspaceId", "regionId", "expiresAt"]
                }
              }
            }
          },
          "303": {
            "description": "Owner cookie issued; redirect to the validated Console return URL."
          },
          "default": {
            "description": "Successful response",
            "headers": { "Cache-Control": { "schema": { "const": "no-store" } } },
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/Error" } }
            }
          }
        },
        "description": "Verified one-use OIDC+PKCE callback. Requires the browser-bound flow cookie; issues an eight-hour, durable, host-only HttpOnly Owner cookie after checking Global Directory membership."
      }
    },
    "/api/auth/tidbcloud/logout": {
      "post": {
        "operationId": "revokeGlobalOwnerSession",
        "security": [{ "globalOwner": [] }],
        "parameters": [
          {
            "name": "workspaceId",
            "in": "query",
            "required": true,
            "schema": { "type": "string" }
          },
          {
            "name": "Origin",
            "in": "header",
            "required": true,
            "schema": { "type": "string", "format": "uri" },
            "description": "Must equal the Global public origin or an explicitly trusted Console origin for Owner mutations."
          }
        ],
        "responses": {
          "204": {
            "description": "Durably revoked the Global Owner session and cleared the host-only cookie."
          },
          "default": {
            "description": "Successful response",
            "headers": { "Cache-Control": { "schema": { "const": "no-store" } } },
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/Error" } }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Error": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "error": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "code": { "type": "string" },
              "message": { "type": "string" },
              "requestId": { "type": "string" }
            },
            "required": ["code", "message", "requestId"]
          }
        },
        "required": ["error"]
      },
      "Key": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "name": { "type": "string", "minLength": 1, "maxLength": 80 },
          "createdAt": { "type": "integer", "minimum": 0 },
          "workspaceId": { "type": "string" },
          "keyId": { "type": "string", "format": "uuid" },
          "principalId": { "type": "string" },
          "keyVersion": { "type": "integer", "minimum": 1 },
          "grantRef": { "type": "string" },
          "expiresAt": { "type": "integer", "minimum": 1 },
          "revoked": { "type": "boolean" }
        },
        "required": [
          "name",
          "createdAt",
          "workspaceId",
          "keyId",
          "principalId",
          "keyVersion",
          "grantRef",
          "expiresAt",
          "revoked"
        ]
      },
      "Grants": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "scopes": {
            "type": "array",
            "items": { "type": "string" },
            "minItems": 1,
            "maxItems": 8
          },
          "resourceIds": {
            "type": "array",
            "items": { "type": "string" },
            "minItems": 1,
            "maxItems": 1024
          },
          "regionId": { "type": "string" }
        },
        "required": ["scopes", "resourceIds", "regionId"]
      },
      "Region": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "regionId": { "type": "string" },
          "apiOrigin": { "type": "string", "format": "uri" },
          "apiPathPrefix": { "type": "string" }
        },
        "required": ["regionId", "apiOrigin", "apiPathPrefix"]
      },
      "Issuance": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string" },
          "keyId": { "type": "string" },
          "principalId": { "type": "string" },
          "expiresAt": { "type": "integer", "minimum": 1 },
          "audience": { "type": "string" },
          "status": { "const": "issued" }
        },
        "required": ["id", "keyId", "principalId", "expiresAt", "audience", "status"]
      },
      "Token": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string" },
          "accessToken": { "type": "string" },
          "tokenType": { "const": "Bearer" },
          "expiresAt": { "type": "integer", "minimum": 1 },
          "scopes": { "type": "array", "items": { "type": "string" } }
        },
        "required": ["id", "accessToken", "tokenType", "expiresAt", "scopes"]
      },
      "RegionToken": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string" },
          "accessToken": { "type": "string" },
          "tokenType": { "const": "Bearer" },
          "expiresAt": { "type": "integer", "minimum": 1 },
          "scopes": { "type": "array", "items": { "type": "string" } },
          "keyId": { "type": "string" },
          "principalId": { "type": "string" },
          "keyVersion": { "type": "integer", "minimum": 1 },
          "region": { "$ref": "#/components/schemas/Region" },
          "enrollmentTicket": { "type": "string" },
          "enrollmentExpiresAt": { "type": "integer", "minimum": 1 },
          "nonce": { "type": "string" }
        },
        "required": [
          "id",
          "accessToken",
          "tokenType",
          "expiresAt",
          "scopes",
          "keyId",
          "principalId",
          "keyVersion",
          "region",
          "enrollmentTicket",
          "enrollmentExpiresAt",
          "nonce"
        ]
      },
      "RegionAccessToken": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string" },
          "accessToken": { "type": "string" },
          "tokenType": { "const": "Bearer" },
          "expiresAt": { "type": "integer", "minimum": 1 },
          "scopes": { "type": "array", "items": { "type": "string" } },
          "keyId": { "type": "string" },
          "principalId": { "type": "string" },
          "keyVersion": { "type": "integer", "minimum": 1 },
          "region": { "$ref": "#/components/schemas/Region" }
        },
        "required": [
          "id",
          "accessToken",
          "tokenType",
          "expiresAt",
          "scopes",
          "keyId",
          "principalId",
          "keyVersion",
          "region"
        ]
      }
    },
    "securitySchemes": {
      "globalOwner": { "type": "apiKey", "in": "cookie", "name": "aw_global_owner" },
      "globalAccess": { "type": "http", "scheme": "bearer", "bearerFormat": "Global JWT" },
      "workspaceKey": {
        "type": "http",
        "scheme": "bearer",
        "description": "Workspace Key is sent only to Global token issuance, never forwarded to Region."
      }
    }
  }
}
