# TiDB Cloud SSO ("Continue with TiDB Account") — OIDC public-client authorization-code + S256 PKCE.
#
# Copy to .env (git-ignored) and fill with values supplied by the TiDB Cloud SSO provider.
# Leave everything blank/unset to cleanly DISABLE SSO: the button is hidden, the /api/auth/*
# endpoints report "SSO not configured", and the local anonymous demo session works as before.
# When SSO IS configured, the anonymous demo session is disabled (it cannot bypass sign-in).
#
# NEVER commit real values. .env is git-ignored; only this .env.example (placeholders) is tracked.

# OIDC issuer URL. REQUIRED when SSO is enabled: it is the expected ID-token issuer and is always
# verified exactly, including a trailing slash if the provider declares one. When the explicit
# *_URL endpoints below are NOT set, authorize/token/jwks/userinfo are
# discovered from <issuer>/.well-known/openid-configuration.
TIDB_SSO_ISSUER=https://sso.example.com/oidc

# Explicit endpoints (optional; override discovery). You may set these AND still must set the
# issuer above (the issuer is always required so the ID token's issuer is checked).
# TIDB_SSO_AUTHORIZE_URL=https://sso.example.com/oauth2/authorize
# TIDB_SSO_TOKEN_URL=https://sso.example.com/oauth2/token
# TIDB_SSO_JWKS_URL=https://sso.example.com/oauth2/jwks
# TIDB_SSO_USERINFO_URL=https://sso.example.com/oauth2/userinfo

# Public OAuth client ID. The provider registration must allow authorization_code,
# S256 PKCE, token endpoint authentication method "none", and the callback below.
# No OAuth client secret is used. See docs/decisions/0015-public-client-sso.md.
TIDB_SSO_CLIENT_ID=your-client-id

# Absolute callback URL registered with the provider. Must point at this app's
# /api/auth/tidbcloud/callback route. https only (http allowed solely for loopback).
# The Secure cookie flag is set automatically when this is an https URL.
TIDB_SSO_REDIRECT_URI=http://127.0.0.1:4318/api/auth/tidbcloud/callback

# Space-separated OAuth scopes (optional; default below).
TIDB_SSO_SCOPES=openid profile email

# Subject claim used for OWNER AUTHORIZATION. The authorization subject is HARD-PINNED to the OIDC
# `sub` claim in code — it is NOT configurable (there is no env var for it), so a reassignable
# value such as email can never become the authorization identity. `sub` must be a non-empty scalar
# string; arrays/objects/numbers fail closed (no owner).

# Optional DISPLAY/AUDIT claim (e.g. "email" or "name"). Recorded for logs/display ONLY and never
# participates in the owner decision. Leave unset to record just the subject.
# TIDB_SSO_DISPLAY_CLAIM=email

# OWNER GRANTS (authorization — DEFAULT-DENY). Exact immutable OIDC `sub` values, NOT emails.
# A verified login needs an exact subject match OR a verified email rule below.
# With both grants empty/unset, EVERY SSO login is denied owner.
# TIDB_SSO_OWNER_SUBJECTS=00u1a2b3c4SUBJECTID,8f3c1e9d-2b47-4c2a-9a1e-provider-sub

# Optional comma-separated exact email or *@domain rules, not arbitrary globs.
# Uses the verified ID token's email with email_verified=true (boolean). Exact domain match,
# case-insensitive email/domain matching; no subdomains, lookalike suffixes or quoted emails.
# Spaces around rules are ignored, duplicates removed; empty items/controls fail startup.
# Identity/audit still uses issuer + sub. ALL matching accounts become full administrators of
# the SAME workspace, including its resources and Workspace Keys. This is NOT user isolation.
# TIDB_SSO_OWNER_EMAIL_RULES=*@pingcap.com,alice@example.net,*@example.org

# Optional org FILTER (not an owner grant). Comma-separated token org ids/names, NOT website
# origins or email domains. Empty = no org filter. When set, it applies to BOTH owner grants.
# TIDB_SSO_ALLOWED_ORGS=org_123,org_456
# ID-token claim holding the org value checked against the filter (optional; default "org_id").
# TIDB_SSO_ORG_CLAIM=org_id

# Where to land in the app after a successful sign-in (optional; must share the redirect URI's
# origin — this is the open-redirect allowlist). Defaults to the redirect URI origin root.
# TIDB_SSO_POST_LOGIN_URL=http://127.0.0.1:4318/

# ---- Public deployment (reverse proxy) ----
# API bind address: unset defaults to 127.0.0.1. Explicitly set 0.0.0.0 for
# a container behind a private Kubernetes Service. Other/empty values fail startup.
# This does not change Host/origin checks, authentication, or publish an ingress.
# WORKSPACE_API_HOST=0.0.0.0
# By default the API serves loopback hosts only. To run behind a real HTTPS reverse proxy
# (e.g. https://tidb.ai), set the trusted public origin(s). Exact https origins, no path/creds.
# Leave unset to keep the loopback-only default.
# TIDB_PUBLIC_ORIGIN=https://tidb.ai
# WORKSPACE_TRUSTED_ORIGINS=https://tidb.ai,https://app.tidb.ai

# Optional public gateway prefix. Empty by default; no trailing slash.
# When set, include this prefix in TIDB_SSO_REDIRECT_URI and the post-login URL.
# The gateway strips this prefix before forwarding requests to the API.
# WORKSPACE_PUBLIC_PATH=/studio
